-COPY --chown=webuser:webgroup . .
-RUN npm install
-RUN npm approve-scripts -all
-
-EXPOSE 5173
-CMD ["npm", "run", "dev", "--", "--host"]
\ No newline at end of file
+# --- runtime: only the build output and production dependencies ---
+FROM node:${NODE_VERSION}-alpine${ALPINE_VERSION}
+ENV NODE_ENV=production \
+    PORT=3000
+WORKDIR /app
+# Files stay owned by root, so the app can't modify its own code. Runs fine with a
+# read-only root filesystem; nothing is written at runtime.
+COPY --from=build /app/package.json ./
+COPY --from=build /app/node_modules ./node_modules
+COPY --from=build /app/build ./build
+# Numeric UID/GID so Kubernetes runAsNonRoot can verify it (the "node" user is 1000).
+USER 1001:1001
+EXPOSE 3000
+# Secrets (GMAIL_*, GOOGLE_*, RECIPIENT_EMAIL) are read at runtime from the environment.
+CMD ["node", "build"]
